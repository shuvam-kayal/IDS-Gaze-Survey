{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ids-gaze-survey.local/p4/analysis-extension.v1.schema.json",
  "title": "Person 4 Analysis Extension",
  "description": "Optional P4 extension inside frozen AnalysisRequest v1 parameters.p4_extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_types"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "analysis_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["paired_comparison", "multiple_comparison", "baseline", "ml_experiment", "modality_comparison", "discrepancy", "gaze_interaction_comparison", "attention_importance_comparison", "aoi_summary", "aoi_comparison", "heatmap", "report", "anomaly_detection", "dimensionality_reduction", "feature_selection", "outlier_generation", "temporal_analysis", "cross_validation", "model_selection"]}}
  }
}
