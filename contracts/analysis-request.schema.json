{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ids-gaze-survey.local/contracts/analysis-request.schema.json",
  "title": "Person 4 AnalysisRequest adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "study_id", "feature_set_version", "modality_policy", "analysis_types"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1},
    "feature_set_version": {"type": "string", "minLength": 1},
    "modality_policy": {"enum": ["best_available", "gaze_only", "non_gaze_only"]},
    "analysis_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["descriptive", "correlation", "group_comparison", "paired_comparison", "multiple_comparison", "baseline", "ml_experiment", "modality_comparison", "discrepancy", "gaze_interaction_comparison", "attention_importance_comparison", "clustering", "aoi_summary", "aoi_comparison", "heatmap", "report", "anomaly_detection", "dimensionality_reduction", "feature_selection", "outlier_generation", "temporal_analysis", "cross_validation", "model_selection"]}},
    "parameters": {"type": "object"},
    "feature_records": {"type": "array", "items": {"$ref": "#/$defs/featureRecord"}}
  },
  "$defs": {
    "featureValue": {"oneOf": [{"type": ["number", "string", "boolean", "null"]}, {"type": "object", "required": ["value"], "properties": {"value": {"type": ["number", "string", "boolean", "null"]}, "unit": {"type": ["string", "null"]}, "modality": {"type": ["string", "null"]}, "type": {"type": "string"}, "aoi_id": {"type": "string"}, "quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}]},
    "featureRecord": {"type": "object", "required": ["features"], "properties": {"record_id": {"type": "string"}, "study_id": {"type": "string"}, "session_id": {"type": "string"}, "participant_id": {"type": "string"}, "feature_set_version": {"type": "string"}, "modality": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}, "features": {"type": "object", "additionalProperties": {"$ref": "#/$defs/featureValue"}}, "feature_quality": {"type": "object", "additionalProperties": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}, "spatial": {"type": "object"}}}
  }
}
