{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InteractionEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "experience_id",
    "study_ids",
    "session_id",
    "event_type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string"
    },
    "experience_id": {
      "type": "string"
    },
    "study_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "session_id": {
      "type": "string"
    },
    "participant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "enum": [
        "interaction.click",
        "interaction.hover",
        "interaction.scroll",
        "interaction.navigation",
        "page.visibility_changed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
